# duckb2cli settings. Copy to duckb2cli.env (current directory) or to
#   Linux:   ~/.config/duckb2cli/config.env
#   Windows: %APPDATA%\duckb2cli\config.env
# Environment variables with the same names override these values, and command-line options override both.
# The file holds a secret: keep it private (chmod 600) and out of version control.

# Quack server address and port (default port 9494)
DUCKDB_HOST_BIND=192.168.0.94
DUCKDB_HOST_PORT=9494

# Token the server was started with (quack_serve(..., token := '...'))
DUCKDB_QUACK_TOKEN=change-me

# Optional: a full URI instead of host/port
#DUCKDB_QUACK_URI=quack://192.168.0.94:9494

# Optional: force TLS on (true) or off (false); leave unset for the extension default
#DUCKDB_QUACK_SSL=true
# Optional: pin the server certificate (SHA-256 fingerprint, hex)
#DUCKDB_QUACK_SSL_FINGERPRINT=

# Optional: name of the attached remote database (default: remote)
#DUCKDB_QUACK_ALIAS=remote
